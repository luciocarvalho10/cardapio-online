# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Covers JetBrains IDEs: IntelliJ, WebStorm, PhpStorm, etc.

# User-specific stuff
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries
.idea/shelf

# Generated files
.idea/httpRequests
.idea/dataSources/
.idea/dataSources.ids
.idea/dataSources.local.xml
.idea/sqlDataSources.xml
.idea/dynamic.xml
.idea/uiDesigner.xml

# Sensitive or temporary
.idea/usage.statistics.xml
.idea/deployment.xml
.idea/deploymentTargetDropHistory.xml

# Ignore all .idea content except project configs
.idea/*
!.idea/modules.xml
!.idea/misc.xml
!.idea/vcs.xml
!.idea/jsLibraryMappings.xml


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
